# Copy to .env.local and fill in. Never commit real values.
# Generate secrets with: openssl rand -hex 32

# --- Admin ---
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Contact form ---
CSRF_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=shwaki-glassworks
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Google reviews (live rating; omitted when unset) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Rate limiting (shared across serverless instances) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Ask AI (home search) + chat assistant ---
ANTHROPIC_API_KEY=
AI_SEARCH_MODEL=claude-haiku-5-5
AI_SEARCH_DAILY_LIMIT=500
# Chat model (defaults to AI_SEARCH_MODEL) and site-wide daily cap on chat replies
AI_CHAT_MODEL=claude-haiku-5-5
AI_CHAT_DAILY_LIMIT=1000
