# Copy to .env.local and fill in. Never commit real values.
# Generate secrets with: openssl rand -hex 32

# --- Admin ---
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Contact form ---
CSRF_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=shwaki-glassworks
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Google reviews (live rating; omitted when unset) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Rate limiting (shared across serverless instances) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Website assistant (Ask AI box + chat) ---
# Our own answer engine needs no AI and no keys. Optional free-tier AI for the questions it can't answer:
# none (default) | groq | cloudflare | gemini — or a fallback chain, e.g. groq,cloudflare
# NEVER add a credit card or enable billing on these accounts, so they can never charge you.
AI_PROVIDER=none
# Max AI answers per day, site-wide (counted in Upstash) — keep it below the providers' free quotas; 0 turns the AI off
AI_DAILY_LIMIT=300
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Google AI Studio free tier: content may be used by Google to improve its products (we send no personal data)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional PAID adapter — used only with AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-haiku-5-5

# --- Daily Telegram summary of unanswered questions (Vercel Cron) ---
CRON_SECRET=
UNANSWERED_SUMMARY=on
